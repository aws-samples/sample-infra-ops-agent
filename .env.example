# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Bedrock Guardrails (H3) — create a guardrail with denied topics, content
# filters, and PII masking, then set its ID/version here so both agents attach
# it to every model invocation. Leave blank only for isolated local testing.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ─── Credentials (M4) ───
# For production, DO NOT put API tokens in this file. Store them in AWS Secrets
# Manager and set the *_SECRET_ID vars below to the secret name/ARN. The token
# is then resolved at runtime via the task IAM role. The plain *_API_TOKEN vars
# below are a fallback for local development only.

# JIRA
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=automation@your-org.com
JIRA_SECRET_ID=                 # e.g. infra-agent/jira  (secret JSON: {"api_token": "..."})
JIRA_API_TOKEN=your-jira-api-token   # local-dev fallback only

# AWX (Ansible Tower)
AWX_BASE_URL=https://awx.your-org.com
AWX_SECRET_ID=                  # e.g. infra-agent/awx   (secret JSON: {"api_token": "..."})
AWX_API_TOKEN=your-awx-token         # local-dev fallback only

# Session persistence (DynamoDB)
DYNAMODB_TABLE_NAME=infrastructure-agent-sessions
DYNAMODB_REGION=us-east-1

# Optional: ServiceNow (store credentials in Secrets Manager for production)
SERVICENOW_INSTANCE=https://your-org.service-now.com
SERVICENOW_USER=api-user
SERVICENOW_SECRET_ID=           # e.g. infra-agent/servicenow
SERVICENOW_PASSWORD=change-me        # local-dev fallback only
