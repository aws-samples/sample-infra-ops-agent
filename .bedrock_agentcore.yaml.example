# AgentCore deployment config — generated by `agentcore configure`.
# This is an EXAMPLE. Run `agentcore configure` to generate your own with your
# account ID, execution role ARN, and ECR repository. Do NOT commit the real file.
default_agent: infra_provisioning_agent
agents:
  infra_provisioning_agent:
    name: infra_provisioning_agent
    entrypoint: agentcore_handler.py
    deployment_type: container
    platform: linux/arm64
    aws:
      execution_role: arn:aws:iam::<ACCOUNT_ID>:role/<EXECUTION_ROLE>
      account: "<ACCOUNT_ID>"
      region: us-east-1
      ecr_repository: <ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/infra-provisioning-agent
    protocol_configuration:
      server_protocol: HTTP
    observability:
      enabled: true
